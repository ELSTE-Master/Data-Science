    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| eval: true\n",
        "\n",
        "fig, ax = plt.subplots()\n",
        "# Plot histogram\n",
        "sns.histplot(data=df_traces, x='Zr', bins=10, color=blue, alpha=.5)\n",
        "ax.set_xlabel('Zr (ppm)');\n",
        "ax.set_title('Zr distribution');"
      ],
      "id": "9a38c74e",
      "execution_count": null,
      "outputs": []
