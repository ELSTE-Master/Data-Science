        "#| echo: false\n",
        "from pywebexercises.exercises import mcq, longmcq, torf\n",
        "import matplotlib.pyplot as plt\n",
        "plt.rcParams.update({\n",
        "    \"figure.facecolor\":  (0.0, 0.0, 0.0, 0.0),  # red   with alpha = 30%\n",
        "})"
      ],
      "id": "0cb24599",
